rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /usernames/{usernameKey} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    function validPresence(userId) {
      return signedIn()
             && request.auth.uid == userId
             && request.resource.data.keys().hasAll(["online", "lastSeen", "username"])
             && request.resource.data.keys().hasOnly(["online", "lastSeen", "username"])
             && request.resource.data.online is bool
             && request.resource.data.lastSeen is timestamp
             && request.resource.data.username is string;
    }

    match /presence/{userId} {
      allow read: if signedIn();
      allow create, update: if validPresence(userId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == userId
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /dailyRuns/{date}/results/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == userId
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.date == date
                            && request.resource.data.username is string
                            && request.resource.data.start is string
                            && request.resource.data.goal is string
                            && request.resource.data.clicks is int
                            && request.resource.data.seconds is int;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == "pending";
      allow update: if signedIn()
                    && resource.data.toUid == request.auth.uid
                    && request.resource.data.fromUid == resource.data.fromUid
                    && request.resource.data.toUid == resource.data.toUid
                    && request.resource.data.status in ["accepted", "declined"];
      allow delete: if signedIn()
                    && (resource.data.fromUid == request.auth.uid
                        || resource.data.toUid == request.auth.uid);
    }

    match /gameInvites/{inviteId} {
      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == "pending";
      allow read: if signedIn()
                  && (resource.data.toUid == request.auth.uid
                      || resource.data.fromUid == request.auth.uid);
      allow delete: if signedIn()
                    && (resource.data.toUid == request.auth.uid
                        || resource.data.fromUid == request.auth.uid);
      allow update: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid && request.resource.data.status == "waiting";
      allow update, delete: if signedIn() && resource.data.hostUid == request.auth.uid;
      match /players/{playerId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == playerId && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == playerId;
      }
      match /chat/{messageId} {
        function isPlayer() {
          return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
        }
        allow read: if isPlayer();
        allow create: if isPlayer()
                      && request.resource.data.keys().hasAll(["uid", "username", "text", "createdAt"])
                      && request.resource.data.keys().hasOnly(["uid", "username", "text", "createdAt"])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.username is string
                      && request.resource.data.username.size() <= 24
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 300
                      && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}